{
  "name": "sentinel",
  "version": "0.1.0",
  "private": true,
  "description": "Sentinel - scope-enforced security recon agent on the TrueForge agent harness",
  "license": "MIT",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22.14"
  },
  "dependencies": {
    "@truefoundry/trueforge": "0.1.4",
    "@truefoundry/trueforge-sdk": "^0.1.0",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "harness": "trueforge --port 8790",
    "build": "pnpm -r build",
    "scope-guard": "node mcp/scope-guard/dist/index.js",
    "scope-guard:dev": "tsx mcp/scope-guard/src/index.ts"
  },
  "pnpm": {
    "overrides": {
      "@aws-sdk/client-s3": "3.1116.0",
      "@aws-sdk/lib-storage": "3.1116.0"
    }
  }
}

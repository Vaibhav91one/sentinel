# Sentinel deploy .env — copy to <repo-root>/.env on the VM, fill in real
# values, chmod 600 it, and NEVER commit it (already covered by .gitignore's
# existing `data/scope.json`/`data/audit.jsonl` entries — add `.env` too if
# it isn't already ignored at the repo root).
#
# Unlike local dev, a deployed instance should always set GUARD_TOKEN,
# CONSOLE_TOKEN, and REQUIRE_GUARD_TOKEN=1 — without them the console and
# guard both run in open/dev mode (see SECURITY.md R1/R2).

# --- LLM provider (at least one required) ---
DEEPSEEK_API_KEY=sk-your-key-here
# OPENAI_ACTIVE=1
# OPENAI_MODEL=gpt-5-mini

# --- Auth (REQUIRED for a deployed instance — this is the whole security
#     boundary once the console is reachable off-box) ---
# Generate with: openssl rand -hex 24
GUARD_TOKEN=
# Generate with: openssl rand -hex 16
CONSOLE_TOKEN=
# Fails closed: without a configured GUARD_TOKEN, every policy mutation
# (grants, scope_add/remove) is refused rather than silently open.
REQUIRE_GUARD_TOKEN=1

# --- Optional, off by default (matches local-dev behavior; enable only for
#     intentionally-vulnerable labs you own — see SECURITY.md R16) ---
# SENTINEL_LAB_MODE=1
# EGRESS_PROXY_PORT=9940

# --- Console upstream URLs: leave at these defaults. All three services are
#     co-located on one VM (guard/harness stay loopback-only; console is the
#     only tunnel-fronted process) — only override if you split them across
#     hosts, which this deploy plan does not cover. ---
# PORT=8792
# HARNESS=http://localhost:8790
# GUARD=http://127.0.0.1:9930
